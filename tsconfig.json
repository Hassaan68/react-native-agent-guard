{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "react-native-agent-guard": ["./src/index.ts"]
    },
    "rootDir": ".",
    "outDir": "dist"
  },
  "include": ["src", "__tests__", "examples/expo-example/App.tsx", "tsup.config.ts"],
  "exclude": ["node_modules", "dist"]
}
