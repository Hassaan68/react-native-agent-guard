{
  "name": "react-native-agent-guard",
  "version": "0.1.5",
  "description": "Zero-dependency permission, policy, validation, and human-in-the-loop guardrails for AI agents in React Native.",
  "author": {
    "name": "Muhammad Hassaan",
    "email": "hassaanmuhammad526@gmail.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammadhassaan/react-native-agent-guard.git"
  },
  "homepage": "https://github.com/muhammadhassaan/react-native-agent-guard#readme",
  "bugs": {
    "url": "https://github.com/muhammadhassaan/react-native-agent-guard/issues",
    "email": "hassaanmuhammad526@gmail.com"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "peerDependencies": {
    "expo-local-authentication": ">=13.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.72.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "expo-local-authentication": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-native": "^0.76.0",
    "ts-jest": "^29.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "zod": "^4.0.0"
  },
  "keywords": [
    "react-native",
    "expo",
    "ai",
    "agent",
    "ai-agents",
    "llm",
    "tool-calling",
    "function-calling",
    "human-in-the-loop",
    "hitl",
    "mcp",
    "model-context-protocol",
    "openai",
    "claude",
    "anthropic",
    "zod",
    "guardrails",
    "permissions",
    "biometrics",
    "security",
    "typescript"
  ],
  "packageManager": "pnpm@9.15.0"
}
